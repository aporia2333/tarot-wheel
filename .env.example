# Public Supabase project settings (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Generate with: openssl rand -base64 32
# Never commit this value or expose it with a NEXT_PUBLIC_ prefix.
READINGS_ENCRYPTION_KEY=replace-with-a-32-byte-base64-key

# Server-only DeepSeek credentials. Never add a NEXT_PUBLIC_ prefix.
DEEPSEEK_API_KEY=your-deepseek-api-key
# Optional; current default is deepseek-v4-flash.
DEEPSEEK_MODEL=deepseek-v4-flash
# Comma-separated account emails allowed to call the paid AI endpoint.
AI_ALLOWED_EMAILS=jeffjiang1082@outlook.com
